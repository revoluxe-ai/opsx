{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stroy-system.local/opsx/architecture_evidence_tool_execution.schema.json",
  "title": "ArchitectureEvidenceToolExecutionReceipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "trust_schema_version",
    "receipt_kind",
    "capture_id",
    "change_id",
    "inputs_digest",
    "permitted_tool",
    "issuer_profile",
    "bound_content_sha256",
    "source_uri",
    "publisher",
    "documented_version",
    "execution_proof_fixture"
  ],
  "properties": {
    "trust_schema_version": { "type": "integer", "const": 1 },
    "receipt_kind": { "type": "string", "const": "TOOL_EXECUTION" },
    "capture_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,62}$" },
    "change_id": { "type": "string", "minLength": 1 },
    "inputs_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "permitted_tool": {
      "type": "string",
      "enum": ["context7-mcp", "official-provider-export", "agent-readonly-fetch"]
    },
    "issuer_profile": { "type": "string", "minLength": 1 },
    "bound_content_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "source_uri": { "type": "string", "minLength": 1 },
    "publisher": { "type": "string", "minLength": 1 },
    "documented_version": { "type": "string", "minLength": 1 },
    "execution_proof_fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "content_sha256"],
      "properties": {
        "path": { "type": "string" },
        "content_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    }
  }
}
