{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bounded-verify-ledger-v1",
  "title": "BoundedVerificationLedger",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "ledger_id",
    "plan_id",
    "plan_fingerprint",
    "ledger_revision",
    "ledger_status",
    "entries",
    "current_assignment"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "bounded-verify-ledger-v1"
    },
    "ledger_id": {
      "type": "string",
      "minLength": 1
    },
    "plan_id": {
      "type": "string",
      "minLength": 1
    },
    "plan_fingerprint": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "ledger_revision": {
      "type": "integer",
      "minimum": 1
    },
    "ledger_status": {
      "type": "string",
      "enum": ["ACTIVE", "COMPLETE"]
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["check_id", "order", "state"],
        "properties": {
          "check_id": {
            "type": "string",
            "minLength": 1
          },
          "order": {
            "type": "integer",
            "minimum": 1
          },
          "state": {
            "type": "string",
            "enum": ["PENDING", "CURRENT", "PASS", "FAIL"]
          },
          "last_fail_ledger_revision": {
            "type": "integer",
            "minimum": 1
          },
          "accepted_result_id": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "accepted_execution_id": {
            "type": "string",
            "minLength": 1
          },
          "accepted_assignment_epoch": {
            "type": "integer",
            "minimum": 1
          },
          "accepted_ledger_revision": {
            "type": "integer",
            "minimum": 1
          },
          "accepted_content_digest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "completion_attestation": {
      "type": "string",
      "enum": [
        "FULL_REQUIRED_VERIFICATION_COMPLETE",
        "BOUNDED_STATIC_VERIFICATION_COMPLETE",
        "LEGACY_BOUNDED_VERIFICATION_COMPLETE"
      ]
    },
    "current_assignment": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["check_id", "assignment_epoch"],
          "properties": {
            "check_id": {
              "type": "string",
              "minLength": 1
            },
            "assignment_epoch": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      ]
    }
  }
}
