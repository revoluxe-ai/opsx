{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "opsx.apply_design",
  "title": "APPLY DESIGN",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "change_id",
    "status",
    "generated_at",
    "chat_history_required",
    "write_boundary",
    "planning_identity",
    "artifact_identity",
    "blockers",
    "next_stage"
  ],
  "properties": {
    "schema": { "const": "opsx.apply_design" },
    "schema_version": { "const": 4 },
    "change_id": { "type": "string", "minLength": 1 },
    "status": { "enum": ["APPLY_DESIGN_READY", "BLOCKED"] },
    "generated_at": { "type": "string", "minLength": 1 },
    "chat_history_required": { "const": false },
    "write_boundary": { "$ref": "#/definitions/writeBoundary" },
    "planning_identity": { "$ref": "#/definitions/planningIdentity" },
    "repository_identity": { "$ref": "#/definitions/repositoryIdentity" },
    "protected_context_identity": { "$ref": "#/definitions/digestPaths" },
    "process_contract_identity": { "$ref": "#/definitions/digestPaths" },
    "pipeline_mutable_paths": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "artifact_identity": { "$ref": "#/definitions/artifactIdentity" },
    "architecture_summary": { "type": "string" },
    "reuse_decisions": {
      "type": "array",
      "items": { "$ref": "#/definitions/reuseDecision" }
    },
    "architectural_constraints": {
      "type": "array",
      "items": { "type": "object", "additionalProperties": true }
    },
    "slices": {
      "type": "array",
      "items": { "$ref": "#/definitions/slice" }
    },
    "slice_order": { "$ref": "#/definitions/sliceOrder" },
    "cross_slice_contracts": {
      "type": "array",
      "items": { "type": "object", "additionalProperties": true }
    },
    "composition_completeness": { "type": "object", "additionalProperties": true },
    "knowledge_obligations": {
      "type": "array",
      "items": { "type": "object", "additionalProperties": true }
    },
    "unresolved_items": {
      "type": "array",
      "items": { "type": "object", "additionalProperties": true }
    },
    "blockers": {
      "type": "array",
      "items": { "type": "object", "additionalProperties": true }
    },
    "next_stage": { "type": "string", "minLength": 1 }
  },
  "definitions": {
    "writeBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["product_code", "tests", "allowed_paths"],
      "properties": {
        "product_code": { "const": false },
        "tests": { "const": false },
        "allowed_paths": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "planningInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "role": { "type": "string" },
        "sha256": { "type": "string", "minLength": 64 }
      }
    },
    "planningIdentity": {
      "type": "object",
      "additionalProperties": true,
      "required": ["change_root", "inputs", "planning_digest"],
      "properties": {
        "change_root": { "type": "string", "minLength": 1 },
        "inputs": {
          "type": "array",
          "items": { "$ref": "#/definitions/planningInput" }
        },
        "planning_digest": { "type": "string", "minLength": 64 }
      }
    },
    "repositoryIdentity": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "head": { "type": "string" },
        "inspected_paths": {
          "type": "array",
          "items": { "type": "string" }
        },
        "inspected_digest": { "type": "string" },
        "candidate_note": { "type": "string" }
      }
    },
    "digestPaths": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "paths": { "type": "array", "items": { "type": "string" } },
        "content_digest": { "type": "string" }
      }
    },
    "artifactIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["human_path", "machine_path"],
      "properties": {
        "human_path": { "type": "string", "minLength": 1 },
        "machine_path": { "type": "string", "minLength": 1 }
      }
    },
    "reuseDecision": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "kind", "surface", "rationale"],
      "properties": {
        "id": { "type": "string" },
        "kind": { "type": "string" },
        "surface": { "type": "string" },
        "rationale": { "type": "string" }
      }
    },
    "imageTaskAcceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ihdr", "visual_rubric"],
      "properties": {
        "ihdr": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": { "type": "integer", "minimum": 1 }
        },
        "registry_member": { "type": "boolean" },
        "visual_rubric": { "type": "string", "minLength": 1 }
      }
    },
    "imageTask": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "purpose",
        "output_path",
        "width",
        "height",
        "format",
        "acceptance"
      ],
      "properties": {
        "task_id": { "type": "string", "minLength": 1 },
        "purpose": { "type": "string", "minLength": 1 },
        "output_path": { "type": "string", "minLength": 1 },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "format": { "type": "string", "minLength": 1 },
        "copy_text": {
          "type": "array",
          "items": { "type": "string" }
        },
        "style_refs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "product_dependencies": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "generation_mode": {
          "type": "string",
          "enum": ["compose_only", "generative_required", "agent_choice"]
        },
        "acceptance": { "$ref": "#/definitions/imageTaskAcceptance" }
      }
    },
    "slice": {
      "type": "object",
      "additionalProperties": true,
      "required": ["slice_id", "title", "scaffold_contract"],
      "properties": {
        "slice_id": { "type": "string", "minLength": 1 },
        "title": { "type": "string" },
        "scaffold_contract": { "type": "object", "additionalProperties": true },
        "image_tasks": {
          "type": "array",
          "items": { "$ref": "#/definitions/imageTask" }
        }
      }
    },
    "sliceOrder": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "kind": { "type": "string" },
        "nodes": { "type": "array", "items": { "type": "string" } },
        "edges": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
        "independent_groups": { "type": "array" }
      }
    }
  }
}
