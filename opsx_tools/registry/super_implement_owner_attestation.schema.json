{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "opsx.super_implement_owner_attestation",
  "title": "Super Implement Owner execution attestation",
  "oneOf": [
    { "$ref": "#/$defs/splitApplyNativeStagesAttestation" },
    { "$ref": "#/$defs/agentHopV0Attestation" }
  ],
  "$defs": {
    "attestationCommonProperties": {
      "schema": { "const": "opsx.super_implement_owner_attestation" },
      "schema_version": { "type": "integer", "const": 1 },
      "owner_attestation_ref": {
        "type": "string",
        "pattern": "^owner-message:"
      },
      "bound_repository_head": {
        "type": "string",
        "pattern": "^[0-9a-f]{40}$"
      },
      "bound_change_root": { "type": "string", "minLength": 1 },
      "bound_change_id": { "type": "string", "minLength": 1 },
      "bound_planning_digest": { "type": "string", "minLength": 1 },
      "attested_at": { "type": "string", "minLength": 10 },
      "attestation_body_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
      "owner_authority_grant_ref": {
        "type": "string",
        "pattern": "^store:(/cursor/stores/|cursor-stores/)"
      },
      "authority_proof_rel_path": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[^/].*"
      }
    },
    "splitApplyNativeStagesAttestation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "schema_version",
        "owner_attestation_ref",
        "bound_change_root",
        "bound_change_id",
        "bound_planning_digest",
        "permitted_write_scope",
        "permitted_primitive_commands",
        "attested_at",
        "attestation_body_sha256",
        "owner_authority_grant_ref"
      ],
      "properties": {
        "schema": { "const": "opsx.super_implement_owner_attestation" },
        "schema_version": { "type": "integer", "const": 1 },
        "owner_attestation_ref": {
          "type": "string",
          "pattern": "^owner-message:"
        },
        "bound_repository_head": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "bound_change_root": { "type": "string", "minLength": 1 },
        "bound_change_id": { "type": "string", "minLength": 1 },
        "bound_planning_digest": { "type": "string", "minLength": 1 },
        "permitted_write_scope": { "const": "split_apply_native_stages" },
        "permitted_primitive_commands": {
          "type": "array",
          "minItems": 6,
          "items": { "type": "string", "pattern": "^/opsx-apply-" }
        },
        "attested_at": { "type": "string", "minLength": 10 },
        "attestation_body_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "owner_authority_grant_ref": {
          "type": "string",
          "pattern": "^store:(/cursor/stores/|cursor-stores/)"
        },
        "authority_proof_rel_path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^/].*"
        }
      }
    },
    "agentHopV0Attestation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "schema_version",
        "owner_attestation_ref",
        "bound_change_root",
        "bound_change_id",
        "bound_planning_digest",
        "permitted_write_scope",
        "permitted_primitive_commands",
        "attested_at",
        "attestation_body_sha256",
        "owner_authority_grant_ref"
      ],
      "properties": {
        "schema": { "const": "opsx.super_implement_owner_attestation" },
        "schema_version": { "type": "integer", "const": 1 },
        "owner_attestation_ref": {
          "type": "string",
          "pattern": "^owner-message:"
        },
        "bound_repository_head": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "bound_change_root": { "type": "string", "minLength": 1 },
        "bound_change_id": { "type": "string", "minLength": 1 },
        "bound_planning_digest": { "type": "string", "minLength": 1 },
        "permitted_write_scope": { "const": "agent_hop_v0" },
        "permitted_primitive_commands": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": { "type": "string", "pattern": "^/opsx-apply-" }
        },
        "attested_at": { "type": "string", "minLength": 10 },
        "attestation_body_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "owner_authority_grant_ref": {
          "type": "string",
          "pattern": "^store:(/cursor/stores/|cursor-stores/)"
        }
      }
    }
  }
}
