{
  "title": "SECURITY_FINDING_PACKET",
  "description": "Case-local confirmed security finding. Absence of this file is not a disposition. Archive review verdicts are not issued here.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "SECURITY_CASE_ID",
    "SECURITY_FINDING_ID",
    "SOURCE",
    "SOURCE_REF",
    "SOURCE_SIGNAL_HASH",
    "TRIAGE_STATUS",
    "SECURITY_CLASS",
    "SEVERITY",
    "CONFIDENCE",
    "CONFIDENCE_IS_PROOF",
    "AFFECTED_PLANE",
    "AFFECTED_SURFACE",
    "PATH",
    "LOC_LINK",
    "SYMBOL",
    "THREAT",
    "ATTACK_PRECONDITION",
    "CAUSAL_PATH",
    "IMPACT",
    "SECURITY_INVARIANT",
    "REMEDIATION_REQUIREMENT",
    "RETEST_REQUIREMENT",
    "REMEDIATION_AUTHORITY_CLASS",
    "SECURITY_BINDING",
    "REMEDIATION_ROUTE",
    "NEXT_COMMAND",
    "EXPECTED_VERIFIER",
    "VERIFIER_GAP",
    "CHANGE_BINDING",
    "EVIDENCE",
    "ASSUMPTIONS",
    "UNRESOLVED",
    "CAPABILITY_PARITY",
    "SECURITY_TRIAGE_DECLARED",
    "SECURITY_REVIEW_VERDICT",
    "NEXT_ACTION",
    "DO_NOT_DO_YET"
  ],
  "properties": {
    "TRIAGE_STATUS": {"const": "CONFIRMED"},
    "CONFIDENCE_IS_PROOF": {"const": "NO"},
    "AFFECTED_PLANE": {
      "enum": ["PRODUCT", "CONTROL_PLANE", "INFRASTRUCTURE"]
    },
    "CAPABILITY_PARITY": {"const": "PARTIAL"},
    "SECURITY_TRIAGE_DECLARED": {"const": "NO"},
    "SECURITY_REVIEW_VERDICT": {"const": "not_issued"}
  }
}
