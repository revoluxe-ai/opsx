  "outside_enforcement": [
    {
      "id": "markdown.slash_command.agent_direct_write",
      "classification": "OUTSIDE_ENFORCEMENT",
      "reason": "Cursor slash commands are markdown; protected writes require agents to invoke registered hooks (guard, skill contract, openspec-cli, apply writer, pipeline gates). Uninstrumented agent file edits are not OS-enforceable in v1."
    },
    {
      "id": "markdown.slash_command.read_only",
      "classification": "OUTSIDE_ENFORCEMENT",
      "reason": "READ_ONLY diagnostics (opsx-verify, opsx-doctor, opsx-execution-preflight, planning-review read paths) do not perform adoption-gated protected writes."
    },
    {
      "id": "control_plane.temporal_dispatch",
      "classification": "OUTSIDE_ENFORCEMENT",
      "reason": "tools/temporal and tools/cursor_executor orchestration are control-plane runtime, not product OpenSpec artifact writers per stroy-system capability split."
    }
  ],
  "bootstrap_exempt_command_ids": [
    "opsx-adopt",
    "opsx-projectize",
    "opsx-meta-bootstrap",
    "opsx-execution-preflight",
    "opsx-doctor",
    "opsx-source-resolution",
