{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "opsx.super_implement_owner_execution_grant",
  "title": "Super Implement Owner execution grant (HMAC, store-held)",
  "oneOf": [
    { "$ref": "#/$defs/splitApplyNativeStagesGrant" },
    { "$ref": "#/$defs/agentHopV0Grant" }
  ],
  "$defs": {
    "splitApplyNativeStagesGrant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "schema_version",
        "grant_id",
        "owner_attestation_ref",
        "bound_change_root",
        "bound_change_id",
        "bound_planning_digest",
        "permitted_write_scope",
        "permitted_primitive_commands",
        "expires_at",
        "signature_hmac_sha256"
      ],
      "properties": {
        "schema": { "const": "opsx.super_implement_owner_execution_grant" },
        "schema_version": { "type": "integer", "const": 1 },
        "grant_id": { "type": "string", "minLength": 8 },
        "owner_attestation_ref": { "type": "string", "pattern": "^owner-message:" },
        "bound_change_root": { "type": "string", "minLength": 1 },
        "bound_change_id": { "type": "string", "minLength": 1 },
        "bound_planning_digest": { "type": "string", "minLength": 1 },
        "bound_repository_head": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "bound_model_route_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "permitted_write_scope": { "const": "split_apply_native_stages" },
        "permitted_primitive_commands": {
          "type": "array",
          "minItems": 6,
          "items": { "type": "string", "pattern": "^/opsx-apply-" }
        },
        "expires_at": { "type": "string", "minLength": 10 },
        "signature_hmac_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "agentHopV0Grant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "schema_version",
        "grant_id",
        "owner_attestation_ref",
        "bound_change_root",
        "bound_change_id",
        "bound_planning_digest",
        "permitted_write_scope",
        "permitted_primitive_commands",
        "bound_execution_id",
        "bound_stage",
        "bound_primitive_command",
        "permitted_write_globs",
        "bound_model_route",
        "bound_model_route_sha256",
        "expires_at",
        "signature_hmac_sha256"
      ],
      "properties": {
        "schema": { "const": "opsx.super_implement_owner_execution_grant" },
        "schema_version": { "type": "integer", "const": 1 },
        "grant_id": { "type": "string", "minLength": 8 },
        "owner_attestation_ref": { "type": "string", "pattern": "^owner-message:" },
        "bound_change_root": { "type": "string", "minLength": 1 },
        "bound_change_id": { "type": "string", "minLength": 1 },
        "bound_planning_digest": { "type": "string", "minLength": 1 },
        "bound_repository_head": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "permitted_write_scope": { "const": "agent_hop_v0" },
        "permitted_primitive_commands": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": { "type": "string", "pattern": "^/opsx-apply-" }
        },
        "bound_execution_id": { "type": "string", "minLength": 8 },
        "bound_stage": {
          "type": "string",
          "enum": [
            "APPLY_DESIGN",
            "APPLY_DESIGN_REVIEW",
            "APPLY_SCAFFOLD",
            "APPLY_RED",
            "APPLY_IMPLEMENT",
            "APPLY_GREEN"
          ]
        },
        "bound_primitive_command": { "type": "string", "pattern": "^/opsx-apply-" },
        "permitted_write_globs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "bound_model_route": { "type": "object", "minProperties": 1 },
        "bound_model_route_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "expires_at": { "type": "string", "minLength": 10 },
        "signature_hmac_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    }
  }
}
