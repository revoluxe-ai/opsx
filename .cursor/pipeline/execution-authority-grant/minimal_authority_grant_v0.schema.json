{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stroy-system.local/schemas/MINIMAL_AUTHORITY_GRANT_V0.json",
  "title": "MINIMAL_AUTHORITY_GRANT_V0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "grant_id",
    "issuer",
    "issued_at",
    "expires_at",
    "subject",
    "repo",
    "change_id",
    "actions",
    "model_tier",
    "owner_fast_allow",
    "exact_token",
    "on_conflict",
    "forbids",
    "owner_attestation_ref"
  ],
  "properties": {
    "schema": { "const": "MINIMAL_AUTHORITY_GRANT_V0" },
    "grant_id": {
      "type": "string",
      "pattern": "^mag-[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "issuer": { "const": "OWNER" },
    "issued_at": { "type": "string", "format": "date-time" },
    "expires_at": { "type": "string", "format": "date-time" },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agent_id", "role"],
      "properties": {
        "agent_id": { "type": "string", "pattern": "^bc-[0-9a-f-]{36}$" },
        "role": { "enum": ["executor", "publisher", "merger"] }
      }
    },
    "repo": { "const": "revoluxe-ai/stroy-system" },
    "change_id": { "type": "string", "minLength": 1 },
    "execution_id": { "type": "string", "minLength": 1 },
    "grant_revision": { "type": "integer", "minimum": 1 },
    "base_oid": {
      "type": "string",
      "pattern": "^[0-9a-f]{7,40}$"
    },
    "tip_oid": {
      "type": "string",
      "pattern": "^[0-9a-f]{7,40}$"
    },
    "ref": {
      "type": "string",
      "pattern": "^refs/heads/"
    },
    "owner_prohibited_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "checkpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "extra_go", "idempotency"],
      "properties": {
        "mode": { "const": "auto_commit_and_push" },
        "extra_go": { "const": false },
        "idempotency": { "const": "git_ff_oid" }
      }
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "local_commit",
          "push_ref",
          "create_pr",
          "update_pr_body",
          "merge",
          "checkpoint_publish"
        ]
      }
    },
    "model_tier": { "const": "inherit" },
    "owner_fast_allow": { "type": "boolean" },
    "exact_token": { "const": "GO" },
    "on_conflict": { "const": "OWNER_ATTENTION" },
    "forbids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "force_push",
          "push_unlisted_oid",
          "merge",
          "deploy",
          "migrate",
          "semantic_write_guess"
        ]
      }
    },
    "evidence_refs": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "revokes": {
      "type": "array",
      "items": { "type": "string", "pattern": "^mag-" }
    },
    "owner_attestation_ref": {
      "type": "string",
      "minLength": 8,
      "description": "Durable Owner-held reference (store path or attested id). Workers MUST NOT mint."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "actions": { "contains": { "const": "push_ref" } }
        },
        "required": ["actions"]
      },
      "then": {
        "required": ["base_oid", "tip_oid", "ref"]
      }
    },
    {
      "if": {
        "properties": {
          "actions": { "contains": { "const": "create_pr" } }
        },
        "required": ["actions"]
      },
      "then": {
        "required": ["base_oid", "ref"]
      }
    },
    {
      "if": {
        "properties": {
          "actions": { "contains": { "const": "checkpoint_publish" } }
        },
        "required": ["actions"]
      },
      "then": {
        "required": ["base_oid", "ref", "checkpoint", "execution_id", "grant_revision"],
        "not": { "required": ["tip_oid"] }
      }
    }
  ]
}
