{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ArchitectureEvidenceCustodianCompatibilityReview",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "custodian_schema_version",
    "kind",
    "issuer",
    "execution_identity",
    "change_id",
    "inputs_digest",
    "design_digest",
    "bound_receipt_sha256",
    "claim_reviews",
    "issued_at"
  ],
  "properties": {
    "custodian_schema_version": { "type": "integer", "const": 1 },
    "kind": { "type": "string", "const": "CUSTODIAN_COMPATIBILITY_REVIEW" },
    "issuer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "repository", "workflow_path", "workflow_ref", "run_id", "actor"],
      "properties": {
        "kind": { "type": "string", "const": "github_actions_workflow" },
        "repository": { "type": "string" },
        "workflow_path": { "type": "string" },
        "workflow_ref": { "type": "string" },
        "run_id": { "type": "string" },
        "run_attempt": { "type": "integer", "minimum": 1 },
        "actor": { "type": "string" }
      }
    },
    "execution_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trust_policy_implementation_id"],
      "properties": {
        "trust_policy_implementation_id": { "type": "string" },
        "cursor_bc_id": { "type": "string" },
        "runner_os": { "type": "string" }
      }
    },
    "change_id": { "type": "string" },
    "inputs_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "design_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "bound_receipt_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "claim_reviews": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claim_id", "compatibility", "verified_facts", "findings"],
        "properties": {
          "claim_id": { "type": "string" },
          "compatibility": { "type": "string", "enum": ["PASS", "FAIL", "BLOCKED"] },
          "verified_facts": { "type": "object" },
          "findings": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "issued_at": { "type": "string" },
    "not_applicable_verdict": {
      "type": "object",
      "properties": {
        "checked": { "type": "boolean" },
        "material_coverage_present": { "type": "boolean" },
        "verdict": { "type": "string", "enum": ["CONFIRMED", "REJECTED"] }
      }
    }
  }
}
